# BRAG LEAD HUNTER — LOCAL PROSPECTING ENGINE (.env.example)
# Copie este arquivo para .env e preencha as chaves conforme necessário.

# Porta do servidor local (padrão: 8090)
PORT=8090

# Caminho do banco SQLite local
DB_PATH=data/brag_lead_hunter.db

# 1. Google Maps / Places API (Opcional — usa OpenStreetMap Nominatim/Overpass + Web Search público gratuitamente quando vazio)
# Custo Google Places API: ~US$ 17 a US$ 32 por 1.000 requisições (com crédito mensal gratuito de US$ 200 do Google Cloud)
GOOGLE_PLACES_API_KEY=

# 2. Apify API Token (Para extração em tempo real do Instagram — reaproveitado de instagram-lead-finder)
# Se existir em ../instagram-lead-finder/.env, o sistema carrega automaticamente como fallback.
APIFY_TOKEN=

# 3. Integração com CRM BRAG (API REST)
# Endpoint padrão compatível com BRAGHIN_IA (/api/v1/crm/companies/ingest)
BRAG_CRM_API_URL=http://localhost:3000
BRAG_CRM_API_KEY=

# 4. Caminho opcional para a base histórica do Instagram Lead Finder (reaproveitamento automático)
LEGACY_IG_LEADS_PATH=../instagram-lead-finder/data/leads.json
